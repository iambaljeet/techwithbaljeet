rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'baljeet.fb@gmail.com';
    }

    // Blog post images and assets: public read, admin write only
    match /posts/{allPaths=**} {
      allow read;
      allow write: if isAdmin() && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    // Deny all other paths by default
    match /{allPaths=**} {
      allow read;
      allow write: if false;
    }
  }
}
